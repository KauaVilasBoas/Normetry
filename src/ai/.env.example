# Copy to src/ai/.env (git-ignored) and replace every value. Placeholders only: never commit real values.

# Shared secret YARP sends in X-Normetry-Internal-Token. Required, at least 32 characters.
NORMETRY_INTERNAL_TOKEN=change-me-to-a-random-value-of-32-chars-or-more

# Runtime connection: the app role (DML only, subject to RLS). SQLAlchemy URL with psycopg 3.
# Optional until the ai schema arrives (#13).
NORMETRY_DATABASE_URL=postgresql+psycopg://app_ai:change-me@localhost:5432/normetry

# Migrations only (read by migrations/env.py): the owner role of schema ai, never the app role.
NORMETRY_MIGRATIONS_DATABASE_URL=postgresql+psycopg://ai_owner:change-me@localhost:5432/normetry

# Traces are exported only when this is set in the process environment (Aspire sets it).
# The OTLP exporter reads OTEL_* from the environment, not from this file.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
