# Copy to src/ai/.env (git-ignored) and replace every value. Placeholders only: never commit real values.

# Shared secret YARP sends in X-Normetry-Internal-Token. Required, at least 32 characters.
NORMETRY_INTERNAL_TOKEN=change-me-to-a-random-value-of-32-chars-or-more

# Runtime connection: the app role (DML only, subject to RLS). SQLAlchemy URL with psycopg 3.
# When set, startup connects once and refuses a role that can get around RLS. Leave it unset for a
# health-only run without a database.
# NORMETRY_DATABASE_URL=postgresql+psycopg://app_ai:change-me@localhost:5432/normetry

# The migrations URL (owner role) never goes here: set NORMETRY_MIGRATIONS_DATABASE_URL in the shell
# for one `uv run alembic ...` command, or let the AppHost's ai-migrate step set it.
# Nor does the corpus URL (corpus_ingestor): set NORMETRY_CORPUS_DATABASE_URL in the shell for one
# `uv run python -m normetry_ai.ingestion.ingest`, or start the AppHost's corpus-ingest resource.

# The embedding model defaults to BGE-M3 at the Hub commit pinned in settings.py. To try another,
# set both NORMETRY_EMBEDDING_MODEL (Hugging Face id) and NORMETRY_EMBEDDING_MODEL_REVISION (commit).

# Traces are exported only when this is set in the process environment (Aspire sets it).
# The OTLP exporter reads OTEL_* from the environment, not from this file.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
