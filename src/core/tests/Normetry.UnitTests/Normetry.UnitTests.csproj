<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Normetry.BuildingBlocks\Normetry.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Normetry.Api\Normetry.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The AI service's read-only blob credential, compiled in rather than referencing the AppHost,
         which would bring the Aspire orchestrator (DCP, dashboard) into the tests. -->
    <Compile
      Include="..\..\Normetry.AppHost\ReadOnlyBlobAccess.cs"
      Link="AppHost\ReadOnlyBlobAccess.cs"
    />
  </ItemGroup>
  <ItemGroup>
    <!-- The queue message contracts both services implement, copied next to the tests. -->
    <None
      Include="..\..\..\shared\contracts\messages\**"
      Link="contracts\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
