<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Normetry.Api\Normetry.Api.csproj" />
    <ProjectReference Include="..\..\Normetry.Migrations\Normetry.Migrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same bootstrap the AppHost mounts, copied next to the tests for the container. -->
    <None
      Include="..\..\..\..\deploy\postgres\init\**"
      Link="postgres-init\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
