<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- DCP and the dashboard come from NuGet, so `dotnet run` needs no Aspire CLI install. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <!-- ASPIRECERTIFICATES001: WithoutHttpsCertificate (keeps loopback endpoints on plain http) is still marked for evaluation. -->
    <NoWarn>$(NoWarn);ASPIRE010;ASPIRECERTIFICATES001</NoWarn>
    <UserSecretsId>a86bacfc-60d9-4ac7-b400-c62d5f8fcdc1</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Normetry.Api\Normetry.Api.csproj" />
    <ProjectReference Include="..\Normetry.Migrations\Normetry.Migrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <!-- The AI service's read-only SAS (ReadOnlyBlobAccess). -->
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Python" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
  </ItemGroup>
</Project>
