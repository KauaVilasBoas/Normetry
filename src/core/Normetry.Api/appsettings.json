{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "http://localhost:8180/realms/normetry",
        "ValidAudiences": ["normetry-api"]
      }
    }
  },
  "Chat": {
    "DefaultPlan": "demo",
    "Plans": {
      "demo": { "DailyMessagesPerUser": 20 },
      "standard": { "DailyMessagesPerUser": 200 },
      "unlimited": { "DailyMessagesPerUser": null }
    },
    "TenantPlans": {}
  },
  "Documents": {
    "MaxDocumentsPerEstablishment": 50,
    "MaxVersionsPerDocument": 20,
    "ProcessingTimeout": "00:15:00",
    "BlobContainer": "documents"
  },
  "Inspections": {
    "DailyQuota": {
      "demo": 5,
      "standard": 20,
      "unlimited": null
    },
    "TokenCeiling": 300000,
    "RunningTimeout": "00:30:00"
  }
}
