{
  "realm": "normetry",
  "displayName": "Normetry (local development)",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "Owner", "description": "Manages the tenant, its establishments and users." },
      { "name": "Manager", "description": "Runs day-to-day compliance work for establishments." },
      { "name": "Auditor", "description": "Read-only access to assessments and evidence." }
    ]
  },
  "clients": [
    {
      "clientId": "normetry-api",
      "name": "Normetry API (token audience only, no login flows)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "normetry-dev",
      "name": "Local manual testing only (password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "normetry-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "normetry-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "normetry-web",
      "name": "Normetry web app (local development)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/auth/callback"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/signed-out"
      },
      "defaultClientScopes": ["basic", "profile", "email", "roles", "web-origins", "acr"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "normetry-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "normetry-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "bistro.owner",
      "enabled": true,
      "email": "owner@bistro.example",
      "emailVerified": true,
      "firstName": "Olivia",
      "lastName": "Owner",
      "attributes": { "tenant_id": ["11111111-1111-4111-8111-111111111111"] },
      "realmRoles": ["Owner"],
      "credentials": [{ "type": "password", "value": "local-demo-only", "temporary": false }]
    },
    {
      "username": "bistro.manager",
      "enabled": true,
      "email": "manager@bistro.example",
      "emailVerified": true,
      "firstName": "Marco",
      "lastName": "Manager",
      "attributes": { "tenant_id": ["11111111-1111-4111-8111-111111111111"] },
      "realmRoles": ["Manager"],
      "credentials": [{ "type": "password", "value": "local-demo-only", "temporary": false }]
    },
    {
      "username": "bakery.auditor",
      "enabled": true,
      "email": "auditor@bakery.example",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Auditor",
      "attributes": { "tenant_id": ["22222222-2222-4222-8222-222222222222"] },
      "realmRoles": ["Auditor"],
      "credentials": [{ "type": "password", "value": "local-demo-only", "temporary": false }]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  }
}
